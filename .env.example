# Copy to .env (never commit .env). All values below are placeholders.
NODE_ENV=development
PORT=8787
# Postgres connection string. For Supabase use the *server-side* connection string
# (Project Settings -> Database). Never the anon key, never in frontend code.
DATABASE_URL=postgres://user:password@localhost:5432/rof
# true in production (Supabase requires TLS)
DATABASE_SSL=false
# Supabase: paste its CA certificate (Project Settings -> Database -> SSL) with newlines written as 
.
# Without it, Node rejects Supabase's certificate chain.
DATABASE_SSL_CA=
# Random secret, >= 32 chars:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL_SECONDS=7200
# Comma-separated browser origins allowed to call the API (public form + admin UI)
CORS_ORIGINS=https://rwandamathcompetition.netlify.app
# true when running behind a reverse proxy / PaaS so client IPs are read from X-Forwarded-For
TRUST_PROXY=false
PUBLIC_RATE_LIMIT_MAX=10
PUBLIC_RATE_LIMIT_WINDOW_MS=600000
# login attempts per minute per IP
LOGIN_RATE_LIMIT_MAX=10
