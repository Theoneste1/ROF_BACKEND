{
  "name": "rof-registration-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API for the Rwanda Mathematics Olympiad school registration system",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "edition:create": "tsx scripts/create-edition.ts",
    "import:legacy": "tsx scripts/import-legacy.ts",
    "locations:seed": "tsx scripts/seed-locations.ts",
    "dev:db": "tsx scripts/dev-pg.ts",
    "import:schools": "tsx scripts/import-schools.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "smoke": "tsx scripts/smoke.ts",
    "gen:secret": "node scripts/gen-secret.mjs",
    "cert:escape": "node scripts/escape-cert.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-socket": "^0.2.15",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
